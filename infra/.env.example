# Copiare in infra/.env (ignorato da Git) e sostituire i valori. Non committare segreti reali.
# Password senza i caratteri ; = $ " (finisce in una connection string e nell'interpolazione Compose).
POSTGRES_PASSWORD=change-me
# Chiave di firma dei JWT: almeno 32 caratteri casuali (es. openssl rand -hex 32).
AUTH_SIGNING_KEY=change-me-with-at-least-32-random-characters
WEB_PORT=8080
# Modello interno (DGX Spark, llama.cpp OpenAI-compatibile). AI_API_KEY non va mai committata.
AI_ENDPOINT=http://dgx-host:8080/v1/
AI_MODEL_ID=model-id-esposto-da-v1-models
AI_API_KEY=change-me
AI_CONTEXT_WINDOW_TOKENS=32768
# Limiti del modello (i valori qui sotto sono i default: omettere le righe per usarli). La finestra deve coincidere con il
# ctx-size per slot del runtime: se /props riporta un valore inferiore, le richieste falliscono con context_window_mismatch.
# AI_MAX_OUTPUT_TOKENS=4096
# AI_SAFETY_MARGIN_TOKENS=1024
# Soglia di compattazione; 0 = uguale al budget di input della fase.
# AI_COMPACTION_TRIGGER_TOKENS=0
# Ragionamento nascosto (Qwen): spento di default.
# AI_ENABLE_THINKING=false
# AI_REQUEST_TIMEOUT_SECONDS=150
# Validità in secondi dello stato verificato del runtime (/props, /slots, /v1/models).
# AI_RUNTIME_CHECK_SECONDS=60
# Override per fase (Chat, Analysis, Document, Compaction): vuoto o assente = eredita il valore globale.
# Il budget di input di ogni fase è AI_CONTEXT_WINDOW_TOKENS - output di fase - AI_SAFETY_MARGIN_TOKENS.
# AI_CHAT_MAX_OUTPUT_TOKENS=
# AI_CHAT_ENABLE_THINKING=
# Analisi: 8192 di default in compose.yaml. L'output strutturato con UUID validi vincolati dalla grammatica costa ~35 token
# per UUID (tokenizer Qwen): sul progetto reale a 9 scambi l'analisi produce 4.300-5.700 token, oltre i 4096 globali.
# Budget di input dell'analisi = 32768 - 8192 - 1024 = 23552 (CompactionTriggerTokens, se impostato, deve restarci dentro).
# AI_ANALYSIS_MAX_OUTPUT_TOKENS=8192
# AI_ANALYSIS_ENABLE_THINKING=
# AI_DOCUMENT_MAX_OUTPUT_TOKENS=
# AI_DOCUMENT_ENABLE_THINKING=
# AI_COMPACTION_MAX_OUTPUT_TOKENS=
# AI_COMPACTION_ENABLE_THINKING=
