# Copiare in infra/.env (ignorato da Git) e sostituire i valori. Non committare segreti reali.
# Password senza i caratteri ; = $ " (finisce in una connection string e nell'interpolazione Compose).
POSTGRES_PASSWORD=change-me
# Chiave di firma dei JWT: almeno 32 caratteri casuali (es. openssl rand -hex 32).
AUTH_SIGNING_KEY=change-me-with-at-least-32-random-characters
WEB_PORT=8080
# Modello interno (DGX Spark, llama.cpp OpenAI-compatibile). AI_API_KEY non va mai committata.
AI_ENDPOINT=http://dgx-host:8080/v1/
AI_MODEL_ID=Qwen3.6-35B-Smart
AI_API_KEY=change-me
# ctx-size del profilo Qwen3.6-35B-Smart (parallel=1): deve coincidere con /props n_ctx, altrimenti context_window_mismatch.
AI_CONTEXT_WINDOW_TOKENS=131072
# Limiti del modello (i valori qui sotto sono i default: omettere le righe per usarli). La finestra deve coincidere con il
# ctx-size per slot del runtime: se /props riporta un valore inferiore, le richieste falliscono con context_window_mismatch.
# AI_MAX_OUTPUT_TOKENS=4096
# AI_SAFETY_MARGIN_TOKENS=1024
# Soglia di compattazione; 0 = uguale al budget di input della fase.
# AI_COMPACTION_TRIGGER_TOKENS=0
# Ragionamento nascosto (Qwen): spento di default; ogni fase lo imposta comunque in modo esplicito (sotto).
# AI_ENABLE_THINKING=false
# AI_REQUEST_TIMEOUT_SECONDS=150
# Validità in secondi dello stato verificato del runtime (/props, /slots, /v1/models).
# AI_RUNTIME_CHECK_SECONDS=60
# Override per fase (Chat, Analysis, Document, Compaction): vuoto o assente = eredita il valore globale.
# Il budget di input di ogni fase è AI_CONTEXT_WINDOW_TOKENS - output di fase - AI_SAFETY_MARGIN_TOKENS.
# *_MODEL_ID: modello della fase (vuoto = AI_MODEL_ID). Deve essere esposto da /v1/models, altrimenti model_not_available
# (nessun fallback). Deve avere la stessa finestra di AI_MODEL_ID: sonda della finestra e conteggio token usano AI_MODEL_ID.
# Chat: ragionamento spento per la reattività.
# AI_CHAT_MODEL_ID=
# AI_CHAT_MAX_OUTPUT_TOKENS=
# AI_CHAT_ENABLE_THINKING=false
# AI_CHAT_REQUEST_TIMEOUT_SECONDS=
# Analisi (consolidamento AnalysisContent): ragionamento acceso, 32768 token di output (il budget di ragionamento resta quello
# del server, --reasoning-budget 12288). Misura Boreale su Qwen3.6: 7.907 token, 132 s a ~60 tok/s; il caso peggiore
# (32768 token ~550 s + prefill + caricamento a freddo) sta nei 900 s di timeout e nei 1200 s di deadline del run.
# Budget di input dell'analisi = 131072 - 32768 - 1024 = 97280.
# Alternativa Qwen3.8 solo per l'analisi (~26 tok/s, 414 s su Boreale): AI_ANALYSIS_MODEL_ID=Qwen3.8-Flash-Next-Smart con
# AI_ANALYSIS_REQUEST_TIMEOUT_SECONDS=1500 e EXECUTION_ANALYSIS_RUN_DEADLINE_SECONDS=1800 (con parallel=1 il server
# alterna i modelli: il primo cambio comporta un caricamento a freddo).
# AI_ANALYSIS_MODEL_ID=
# AI_ANALYSIS_MAX_OUTPUT_TOKENS=32768
# AI_ANALYSIS_ENABLE_THINKING=true
# AI_ANALYSIS_REQUEST_TIMEOUT_SECONDS=900
# EXECUTION_ANALYSIS_RUN_DEADLINE_SECONDS=1200
# Documento Markdown e sintesi della compattazione: ragionamento spento.
# AI_DOCUMENT_MODEL_ID=
# AI_DOCUMENT_MAX_OUTPUT_TOKENS=
# AI_DOCUMENT_ENABLE_THINKING=false
# AI_DOCUMENT_REQUEST_TIMEOUT_SECONDS=
# AI_COMPACTION_MODEL_ID=
# AI_COMPACTION_MAX_OUTPUT_TOKENS=
# AI_COMPACTION_ENABLE_THINKING=false
# AI_COMPACTION_REQUEST_TIMEOUT_SECONDS=
# Estrazione delle evidenze (registro atomico, una chiamata con schema per messaggio PM): ragionamento spento, tetto di output ampio
# perché un messaggio ricco di fatti produce molte evidenze (un'uscita troncata fallisce come invalid_agent_output, mai in silenzio).
# AI_EXTRACTION_MODEL_ID=
# AI_EXTRACTION_MAX_OUTPUT_TOKENS=16384
# AI_EXTRACTION_ENABLE_THINKING=false
# AI_EXTRACTION_REQUEST_TIMEOUT_SECONDS=600
# Stima dell'output dell'estrazione documenti = token posseduti x fattore (candidato 16, non ancora validato da misura reale; 8 fino al 2026-11-10). Un fattore piu alto divide di piu le unita
# (piu chiamate, meno rischio di finish=length); entra nell'hash di configurazione, quindi cambiarlo (o aggiornare dal rilascio che ha introdotto l'etichetta di calibrazione 2026-11-10) con unita in corso le fa fallire in modo esplicito (IntegrityConflict): drenare o ripetere le preparazioni.
# AI_EXTRACTION_OUTPUT_EXPANSION=16
# EXECUTION_EXTRACTION_DEADLINE_SECONDS=3600
# Parser documenti (slice 002): segreto condiviso backend/parser, almeno 32 caratteri casuali (es. openssl rand -hex 32). Vuoto = nessuna conversione.
# PARSER_INTERNAL_SECRET=change-me-with-at-least-32-random-characters
# Indirizzo del parser sulla rete privata (profilo compose `parser`); vuoto = parsing non configurato, i documenti restano In coda.
# PARSER_BASE_URL=http://parser:8000
# Avvio del parser: docker compose -f infra/compose.yaml --profile parser up -d --build --wait parser. Il parser non ha egress ne porte host.
# Limiti e quote documentali (Documents__*): default nel codice, modificabili dall'Admin; non sono variabili di questo file. Dettagli: specs/002-project-documents/validation/operations.md
