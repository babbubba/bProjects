<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Gold di recupero della 003 (T004): promossi dal laboratorio, byte identici; gli hash sono in PROVENANCE.json. -->
  <ItemGroup>
    <None Include="Retrieval/Gold/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fixture di valutazione e baseline offline (T017/T018). -->
    <None Include="Retrieval/Evaluation/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Retrieval/Baseline/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Corpus sintetico dei documenti (T002): copiato accanto ai test, così il percorso non dipende dalla cartella di lavoro. -->
  <ItemGroup>
    <None Include="..\..\..\tests\fixtures\documents\**" Link="fixtures\documents\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\bProjects.App\bProjects.App.csproj" />
  </ItemGroup>

</Project>
